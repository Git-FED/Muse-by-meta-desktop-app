{
  "name": "muse-by-meta-desktop-app",
  "version": "0.1.0",
  "description": "Unofficial desktop wrapper for the Muse web app (Windows)",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "electron .",
    "build": "tsc && electron-builder --win",
    "dist": "electron-builder --win --publish always",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "electron-updater": "^6.0.0",
    "electron-store": "^10.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0",
    "@playwright/test": "^1.48.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0"
  }
}
